# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored - never commit real secrets.
# See README.md -> "Configuration" for what each variable does.

# --- Core -------------------------------------------------------------------
# Profile: "development" (default) or "production". Production refuses to start
# unless SECRET_KEY, FERNET_KEY, DATABASE_URL, PUBLIC_BASE_URL and ALLOWED_HOSTS
# are all set safely.
APP_ENV=development

# Signs session cookies and security tokens. At least 32 random characters:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
# Optional in development (a random key is used per process, so sessions reset).
SECRET_KEY=

# The site's public origin, used for links in emails (never taken from the
# request's Host header). Must be https:// in production.
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Comma-separated host names the site answers on; other Host headers get 400.
# Required in production, e.g. runnify.onrender.com,runnify.app
ALLOWED_HOSTS=

# Reverse proxies in front of the app whose X-Forwarded-* headers are trusted.
# Default: 0 in development, 1 in production (Render).
PROXY_COUNT=

# Maximum upload size in MB (Spotify history zips). Default 100.
MAX_UPLOAD_MB=100

# Where rate-limit counters are kept. memory:// is per process; in production use a
# shared Redis-compatible store (e.g. Render Key Value) so limits hold across workers.
RATELIMIT_STORAGE_URI=memory://

# Database URL. Leave unset to use SQLite (runnify/instance/runnify.db), the default
# while Runnify is being tested. PostgreSQL is supported for later, e.g.
#   DATABASE_URL=postgresql://user:password@localhost:5432/runnify
# (postgres:// and postgresql:// URLs are mapped to the psycopg2 driver automatically.)
DATABASE_URL=

# --- Encryption at rest (required to link Garmin or Spotify) -----------------
# Fernet key that encrypts stored third-party credentials. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Key rotation: list keys newest first; new values use the first, old values
# still decrypt with any of them. Overrides FERNET_KEY when set.
FERNET_KEYS=

# --- Spotify OAuth (https://developer.spotify.com/dashboard) -----------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/spotify/callback
# Space-separated OAuth scopes requested at login (example value - adjust as needed).
SPOTIFY_SCOPE=user-read-recently-played

# --- Outgoing mail (password resets, security notifications) ---------------
# Leave MAIL_SERVER empty in development: emails are written to the log instead.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
