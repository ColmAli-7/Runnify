# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored - never commit real secrets.
# See README.md -> "Configuration" for what each variable does.

# --- Core -------------------------------------------------------------------
# Signs session cookies and password-reset tokens. Use a long random string:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLAlchemy database URL. PostgreSQL is required for the Music Insights page.
# Falls back to a local SQLite file (instance/runnify.db) if unset.
DATABASE_URL=postgresql://user:password@localhost:5432/runnify

# --- Garmin credential encryption (REQUIRED - the app will not start without it)
# Fernet key used to encrypt stored Garmin passwords. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Spotify OAuth (https://developer.spotify.com/dashboard) -----------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/spotify/callback
# Space-separated OAuth scopes requested at login (example value - adjust as needed).
SPOTIFY_SCOPE=user-read-recently-played

# --- Outgoing mail (password-reset emails) ---------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
